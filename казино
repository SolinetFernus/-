using Microsoft.AspNetCore.Mvc;
using CasinoApi.Models;
using CasinoApi.Data;

namespace CasinoApi.Controllers;

[ApiController]
[Route("api/[controller]")]
public class CasinoController : ControllerBase
{
    private readonly Random _rnd = new();

    [HttpGet("play")]
    public IActionResult Play()
    {
        var win = _rnd.Next(1, 101) > 50;
        var amount = win ? _rnd.Next(10, 500) : 0;

        return Ok(new GameResult { Win = win, Amount = amount });
    }

    [HttpPost("withdraw")]
    public IActionResult Withdraw([FromBody] int amount)
    {
        var moral = MoralDb.GetRandomMoral();
        return Ok(new WithdrawResult
        {
            Success = false,
            IsBsod = true,
            Moral = moral,
            Amount = amount
        });
    }

    [HttpGet("morals")]
    public IActionResult GetAllMorals()
    {
        var list = MoralDb.GetAllMorals(); // добавим метод
        return Ok(list);
    }
}

public static List<string> GetAllMorals() => Messages.ToList();

